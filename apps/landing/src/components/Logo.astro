---
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect x="4" y="4" width="24" height="24" rx="3" transform="rotate(45 16 16)" fill="#D97757"></rect>
  <path
    d="M11 21 L16 14 M21 21 L16 14 M16 14 L16 9"
    fill="none"
    stroke="#141413"
    stroke-width="2.2"
    stroke-linecap="round"></path>
</svg>
