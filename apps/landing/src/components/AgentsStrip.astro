---
import { AGENTS } from "../config";
import AgentIcon from "./AgentIcon.astro";

/**
 * Duas fileiras em sentidos opostos. Só a primeira cópia da primeira fileira
 * é lida por leitores de tela; as demais cópias (necessárias para o loop
 * contínuo) ficam em aria-hidden. Sem JS ou com movimento reduzido, a faixa
 * vira uma lista estática que quebra linha.
 */
const rowA = [...AGENTS];
const rowB = [AGENTS[5], AGENTS[6], AGENTS[0], AGENTS[3], AGENTS[1], AGENTS[4], AGENTS[2]].filter(
  (agent): agent is (typeof AGENTS)[number] => agent !== undefined,
);
const COPIES = 4; // 2 metades x 2 cópias: cobre telas largas sem emenda visível
---

<section class="agents" id="agentes" aria-labelledby="agentes-titulo" data-agents data-live>
  <div class="container">
    <div class="agents__head">
      <h2 class="agents__label" id="agentes-titulo">Agentes compatíveis</h2>
      <p class="agents__hint">Claude Code e Codex hoje · mais agentes chegando</p>
      <button class="motion-toggle" type="button" data-motion-toggle hidden>
        <span class="motion-toggle__icon" aria-hidden="true"></span>
        <span data-motion-toggle-label>Pausar animações</span>
      </button>
    </div>
  </div>

  <div class="marquee">
    {
      [
        { row: rowA, reverse: false, main: true },
        { row: rowB, reverse: true, main: false },
      ].map(({ row, reverse, main }) => (
        <div class:list={["marquee__row", { "marquee__row--rev": reverse }]} aria-hidden={main ? undefined : "true"}>
          {Array.from({ length: 2 }, (_, half) => (
            <ul class="marquee__half" aria-hidden={half === 0 && main ? undefined : "true"} aria-label={half === 0 && main ? "Agentes compatíveis" : undefined}>
              {Array.from({ length: COPIES / 2 }, (_, copy) =>
                row.map((agent) => (
                  <li
                    class:list={["agent", { "agent--soon": agent.status === "soon" }]}
                    aria-hidden={half === 0 && copy === 0 && main ? undefined : "true"}
                  >
                    <AgentIcon icon={agent.icon} />
                    <span>
                      <span class="agent__name">{agent.name}</span>
                      {agent.status === "soon" && <span class="agent__tag">em breve</span>}
                    </span>
                  </li>
                )),
              )}
            </ul>
          ))}
        </div>
      ))
    }
  </div>
</section>
